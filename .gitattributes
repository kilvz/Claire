app/src/main/assets/sandbox/mika text eol=lf

# Text files use LF: goldens, prompts and the README are compared byte for byte, so line endings must not vary by platform.
# text=auto leaves binaries alone; gradlew.bat stays CRLF (Windows batch files are unreliable with plain LF).
* text=auto eol=lf
*.bat text eol=crlf
