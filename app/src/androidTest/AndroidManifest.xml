<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The probe page broadcasts records to the tests in the Mika process -->
    <queries>
        <package android:name="com.wangzan101.mika" />
        <!-- Reproducing the "opens on the user's home screen" page requires another app's launch entry point -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <activity android:name="com.wangzan101.mika.cap.phone.display.RotationTestActivity"
            android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Test-only pages, opened onto the virtual display by the tests via am start. They run in the test package's own process
             without the Kotlin standard library, so they are written in Java; class names must match the source files (ManifestProvidersTest checks this) -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SecureTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.PlainTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.GestureTapTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.a11y.WebEditorTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FieldsTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.KeyOnlyEditorTestActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.ClipboardEditorTestActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.HiddenFocusedEditorActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.PointFocusEditorActivity"
            android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <!-- Wheel picker test page: two stock numeric wheel pickers -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.WheelPickerTestActivity" android:exported="true" />
        <!-- Opens another app from the application context: reproduces "opens on the user's home screen" -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SpillTestActivity" android:exported="true" />
        <!-- Dialog-style page: reproduces popups such as login verification that require the user to confirm on the home screen -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.DialogSpillTestActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog" />
        <!-- Full-screen account login page: shaped like a normal app page; only "the containing package is an account authenticator with no launcher icon" can identify it -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FullScreenAuthTestActivity" android:exported="true" />
        <!-- Account authenticator for the test package: disabled by default, enabled only in AuthSpillDeviceTest and disabled again afterwards,
             so other spill-back tests are unaffected. The test package has no LAUNCHER entry, so once enabled it becomes an account authenticator package with no launcher icon -->
        <service android:name="com.wangzan101.mika.cap.phone.a11y.TestAuthenticatorService" android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_authenticator" />
        </service>
        <service android:name="com.wangzan101.mika.cap.phone.a11y.SpillLaunchService" android:process=":spill" android:exported="false" />
        <!-- Probe page for shell parity tests: startApp uses the launch entry point (INFO, not shown in the launcher), startView uses a custom link -->
        <activity android:name="com.wangzan101.mika.shell.ShellProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mika-parity" />
            </intent-filter>
        </activity>
        <!-- Probe page that is always producing audio (looping a silent sound): at task end, apps that are playing audio are closed by default -->
        <activity android:name="com.wangzan101.mika.shell.AudioProbeActivity" android:exported="true" />
    </application>
</manifest>
