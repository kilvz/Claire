<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext http is allowed: model services the user runs on this machine or on the local network
  (such as http://192.168.1.10:11434/v1) usually offer only http. The built-in browser can therefore open
  http pages directly (instead of being refused by the system first and retried over https).
  When adding a provider, an address that is neither encrypted nor on this machine or the local network
  gets one warning (see LocalHosts).
  Trust user-installed CAs: model services on a company intranet (GPUStack/vLLM and the like) often use
  certificates signed by an internal CA, and trusting only system certificates would reject them all.
  Installing a CA takes a deliberate action by the user in system settings, the same stance as cleartext http (see #361).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
