<?xml version="1.0" encoding="utf-8"?>
<!-- Conversation page attachments: photos taken by the camera, private copies of system-shared files, and the copy made when opening an already-sent attachment; the workspace itself is not exposed -->
<paths>
    <cache-path name="camera" path="attach/camera/" />
    <cache-path name="viewing" path="attach/viewing/" />
    <files-path name="library" path="library-attachments/" />
    <cache-path name="library-viewing" path="library-viewing/" />
    <files-path name="shared" path="shared-drafts/" />
</paths>
