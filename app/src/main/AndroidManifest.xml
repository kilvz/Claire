<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Opt-in, task-scoped incoming SMS only; never request READ_SMS or the default SMS role. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Record while push-to-talk, then transcribe to text; also used when pages in the user's browser request the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pages in the user's browser request the camera (Claire takes its own photos through the system camera and does not use this permission); when a page requests it, first show a dialog asking the user. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Pages in the user's browser request location; when a page requests it, first show a dialog asking the user. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- After the user downloads a new version on the About page, hand it to the system installer to confirm the overwrite install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Read the current network's DNS servers when the sandbox goes online -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Voice calls: hold the microphone in the background during a call via a microphone-type foreground service; on Android 12 and below, switching to speaker requires changing the audio route (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Call features: dialing, reading call state, and the Android 13+ "call companion" framework (companion role granted via shell). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_COMPANION_APP" />
    <uses-permission
        android:name="android.permission.MANAGE_ONGOING_CALLS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Batch schedules are written at once through the Android calendar provider; when the user has not granted permission, fall back to the system calendar's create-event page. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- phone_set_alarm / phone_set_timer: ask the clock app to set alarms and timers through the standard Android interface (normal permission, available at install) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- "Auto-restore after reboot": reopen wireless debugging at boot. This grant cannot be obtained by a normal install;
         it is granted only through an already-paired connection after the user turns that switch on. Without declaring it here, even granting would be impossible -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Recent photos" in the conversation attachment panel: reads photos from Android 13, can share only selected photos from 14, and reads external storage on 12 and below.
         Without it, the system photo picker and file picker still work; taking photos uses the system camera and needs no camera permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Conversation attachments can take photos (through the system camera), so the camera is declared as used but is not required: devices without a camera still install normally.
         Some systems classify apps by APK features; without this declaration Claire may be treated as a game and have its refresh rate limited, so this declaration must stay -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Voice input needs the microphone, but it is not required: devices without a microphone still install normally, they just cannot use voice -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Call features need telephony hardware, but it is not required: devices without a call module still install normally, they just cannot make calls. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Web location uses the location permission, but it is not required: devices without location hardware still install normally, web pages just cannot get location -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- list_apps lists launchable apps; resolve the package that hosts the system permission dialog, used to determine "switched away" -->
    <queries>
        <intent><action android:name="android.telecom.InCallService" /></intent>
        <!-- List the text-to-speech engines registered on the phone so the system read-aloud picker can choose one (SystemTtsDiscovery) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- System actions: first check whether a clock or calendar app handles them; if not, fall back to operating the UI -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- Voice input: since Android 11, without declaring this, the phone's built-in recognition service can never be found -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The speech app is checked before offering to install it again; some builds expose only TTS to package queries -->
        <package android:name="com.google.android.tts" />
        <!-- The Google app and Android System Intelligence also host recognition services on many phones; they must be visible for an explicit bind and for the "installed but turned off" explanation -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.android.as" />
        <!-- The onboarding page first checks whether the system developer options page can be opened: if not (some runtime environments lack Android system settings), it states up front that phone control is unavailable -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- Package hosting the account authenticator: system account sign-in services with no launcher icon must also be visible, so their login pages can be left to the user when they pop onto the home screen -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".MikaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- There is only one UI: opening from the launcher, a notification, another app, or a command all return to this one (new opens go to onNewIntent), rather than stacking a second one on top -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Mika"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Overrides the system default app details page shown on tile long-press, returning directly to Claire. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Text, links, or files (single or multiple) shared by the system first go into the conversation draft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".self.SelfNotificationActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Destination for the takeover button in notifications: only starting an Activity from a notification collapses the notification shade, letting the user directly see the app moved to the home screen -->
        <activity
            android:name=".takeover.TakeoverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- In-app file viewer (web pages, Markdown, PDF, images, text); the IME adjusts the window height during in-page search -->
        <activity
            android:name=".ui.viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mika" />

        <!-- User-opened terminal: entered only from within the app, not exported; does not recreate on rotation, IME adjusts the window height -->
        <activity
            android:name=".ui.terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mika" />

        <!-- Web takeover: bring a background web tab (the same WebView) to the home screen for the user to handle -->
        <activity
            android:name=".web.WebTakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Test page operated by the compatibility self-check on Claire's virtual display. Exported only so the built-in assistant (shell) can start it by component name onto Claire's display:
             callers must hold INTERACT_ACROSS_USERS_FULL, which shell has and ordinary apps do not; no intent-filter. Its own task, excluded from recents -->
        <activity
            android:name=".selfcheck.SelfCheckTargetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:windowSoftInputMode="stateHidden" />

        <!-- Android Quick Settings binds this service; ordinary apps cannot toggle the capsule through it. -->
        <service android:name=".capsule.CapsuleTileService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:label="@string/capsule_tile_label"
            android:icon="@drawable/ic_notification">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".a11y.MikaAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Proactive capabilities: disabled by default; enabled by ProactiveRuntime when the feature is first opened, so it appears in the system "notification access" list;
             afterwards, turning the feature off only unbinds and does not disable it (once a component is disabled, the system revokes access).
             exported=false matches the manifest example in the NotificationListenerService docs (the system binds with BIND_NOTIFICATION_LISTENER_SERVICE);
             only ongoing notifications are filtered out, not silent ones (users often set WeChat to silent). -->
        <service
            android:name=".proactive.NoticeListenerService"
            android:enabled="false"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>

        <service
            android:name=".task.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-requested phone task on the app's own virtual display and shows its progress; afterwards keeps the one web page the user asked to keep open running, for at most two hours" />
        </service>

        <!-- Calls: Telecom binds the companion InCallService, while system calls still use their own call UI; the foreground service keeps the process alive while the screen is locked. -->
        <service
            android:name=".calls.MikaInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="false" />
        </service>

        <service
            android:name=".calls.CallStandbyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled incoming call assistant available while the screen is locked and carries one user-confirmed outgoing call across screen lock, with a visible ongoing notification and no idle audio capture" />
        </service>

        <service
            android:name=".calls.CallStandbyRecoveryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".calls.CallNotificationAction" android:exported="false" />
        <!-- Ask the owner from within an AI call: the landing point for replying directly in the notification; not exported (the PendingIntent names this component) -->
        <receiver android:name=".calls.OwnerReplyReceiver" android:exported="false" />

        <!-- In-app voice calls: keep the process and background microphone alive during a call; the notification has a hang-up action and does not open the call page when the screen is locked. -->
        <service
            android:name=".voicecall.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- After the user binds and enables the WeChat channel, keep long polling; there is no local server, and tasks are still handed to TaskService. -->
        <service
            android:name=".wechat.WechatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled WeChat bot connection available so private messages can be handed to the app's existing task service" />
        </service>

        <!-- After the user configures and enables the Telegram bot, keep long polling; there is no local server, and tasks are still handed to TaskService. -->
        <service
            android:name=".telegram.TelegramService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled Telegram bot connection available so private messages can be handed to the app's existing task service" />
        </service>

        <!--
             Computer connection (MCP): runs only after the user enables it in settings, or after the computer enables it via USB debugging, keeping the listening port open in the background; stops when turned off.
             Exported only so adb shell can start it (am start-foreground-service): callers must hold INTERACT_ACROSS_USERS_FULL,
             which shell has, ordinary apps cannot get, and adb cannot grant either
        -->
        <service
            android:name=".mcp.McpService"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled computer access available through a private-network or USB endpoint, or an outbound connection to the user's remote gateway, so authorized clients can hand tasks to the app" />
        </service>

        <!-- During ChatGPT sign-in: keep the process alive while the user logs in in the browser, so the local callback has a receiver; stops as soon as sign-in ends -->
        <service
            android:name=".settings.ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps sign-in alive while the user finishes account login in the external browser, for a loopback callback or device-code polling" />
        </service>

        <!-- Prepare the runtime environment in the background (unpack the root filesystem bundled with the APK); runs only during preparation -->
        <service
            android:name=".sandbox.SandboxService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Web uploads: hand staged upload files to the built-in browser's file chooser as read-only content:// URIs, not exported.
             FileProvider requires grantUriPermissions=true, otherwise it throws at process startup;
             URIs are never granted to other apps here, and the only reader is the WebView in this process. -->
        <provider
            android:name=".web.WebFilesProvider"
            android:authorities="${applicationId}.webfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/web_files" />
        </provider>

        <!-- Chat video cards: when opened, copy the workspace video into the videoplay/ cache and grant the system player access only to that copy -->
        <provider
            android:name=".media.VideoPlaybackFilesProvider"
            android:authorities="${applicationId}.videoplay"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/video_playback_files" />
        </provider>

        <!-- Conversation attachments: the camera writes photos to the camera/ cache, and a copy of a sent attachment is made in viewing/ when opened; nothing is exported, and access is granted temporarily when used -->
        <provider
            android:name=".chat.AttachFilesProvider"
            android:authorities="${applicationId}.attachfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_files" />
        </provider>

        <!-- Task report sharing: temporary body text under cache/report-share/, handed to the system share sheet as a read-only URI, not exported -->
        <provider
            android:name=".ui.ReportFilesProvider"
            android:authorities="${applicationId}.reportfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_files" />
        </provider>

        <!-- Update installers downloaded by Claire itself when using the network proxy: handed read-only to the system installer, not exported, granted temporarily at install time -->
        <provider
            android:name=".about.UpdateFilesProvider"
            android:authorities="${applicationId}.updatefiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_files" />
        </provider>

        <!-- Pairing code entered in the pairing notification's input field -->
        <receiver
            android:name=".setup.PairingCodeReceiver"
            android:exported="false" />

        <!-- Entry point for the built-in assistant (shell identity) to hand over a Binder: shell has this permission, ordinary apps do not;
             after entering, the caller uid, one-time token, and APK are also verified, see HelperHub.offer -->
        <provider
            android:name=".shell.HelperHandoffProvider"
            android:authorities="${applicationId}.helper"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- The boot broadcast is sent only by the system (protected broadcast), exported as required -->
        <receiver
            android:name=".setup.BootRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".task.TriggerAlarmReceiver" android:exported="false" />

        <!-- Broadcast entry point for external scripts to create tasks: exported (no permission), guarded by the "allow external scripts to create tasks" switch + per-minute rate limit + source tag -->
        <receiver
            android:name=".task.ExternalScheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.wangzan101.mika.SCHEDULE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".teach.TeachReceiver" android:exported="false" />
    </application>

</manifest>
